{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Products List Schema",
  "type": "object",
  "required": ["quantidade", "produtos"],
  "properties": {
    "quantidade": {
      "type": "integer",
      "minimum": 0
    },
    "produtos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "preco", "descricao", "quantidade", "_id"],
        "properties": {
          "nome": {
            "type": "string"
          },
          "preco": {
            "type": "integer"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer"
          },
          "_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}